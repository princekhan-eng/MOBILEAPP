generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         String      @default("CUSTOMER") // SUPER_ADMIN, SHOP_ADMIN, SHOP_EMPLOYEE, CUSTOMER
  phone        String?
  avatar       String?
  shopId       String?
  shop         Shop?       @relation("ShopEmployees", fields: [shopId], references: [id], onDelete: SetNull)
  ownedShops   Shop[]      @relation("ShopOwner")
  auditLogs    AuditLog[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Shop {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  description    String?
  logo           String?
  banner         String?
  address        String
  phone          String
  email          String
  status         String         @default("PENDING") // PENDING, ACTIVE, SUSPENDED
  ownerId        String
  owner          User           @relation("ShopOwner", fields: [ownerId], references: [id])
  employees      User[]         @relation("ShopEmployees")
  products       Product[]
  inventories    Inventory[]
  sales          Sale[]
  purchases      Purchase[]
  subscriptions  Subscription[]
  contracts      Contract[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id             String     @id @default(uuid())
  name           String
  slug           String     @unique
  description    String
  price          Float
  compareAtPrice Float?
  images         String     // JSON string array of image URLs
  brand          String
  model          String
  specs          String     // JSON object of key-value specs
  categoryId     String
  category       Category   @relation(fields: [categoryId], references: [id])
  shopId         String
  shop           Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status         String     @default("ACTIVE") // DRAFT, ACTIVE, OUT_OF_STOCK
  inventory      Inventory?
  saleItems      SaleItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Inventory {
  id                String   @id @default(uuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopId            String
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  location          String?
  updatedAt         DateTime @updatedAt
}

model Sale {
  id            String     @id @default(uuid())
  shopId        String
  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String?
  totalAmount   Float
  paymentMethod String     @default("CASH") // CASH, CARD, ONLINE
  status        String     @default("COMPLETED")
  items         SaleItem[]
  createdAt     DateTime   @default(now())
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  subtotal  Float
}

model Purchase {
  id           String   @id @default(uuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierName String
  totalAmount  Float
  status       String   @default("RECEIVED") // PENDING, RECEIVED, CANCELLED
  items        String   // JSON payload of purchase items
  createdAt    DateTime @default(now())
}

model Subscription {
  id           String   @id @default(uuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  planName     String   // BASIC, PRO, ENTERPRISE
  price        Float
  billingCycle String   // MONTHLY, YEARLY
  startDate    DateTime @default(now())
  endDate      DateTime
  status       String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, PENDING
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contract {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title     String
  terms     String
  startDate DateTime
  endDate   DateTime
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String   // PRODUCT_VIEW, PRODUCT_SEARCH, PRODUCT_CLICK, PRODUCT_SALE, STOCK_CHANGE
  productId String?
  shopId    String?
  userId    String?
  metadata  String?  // JSON string metadata
  timestamp DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?  // JSON details
  ipAddress String?
  timestamp DateTime @default(now())
}
